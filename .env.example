# Database 설정
# DB_TYPE: mysql 또는 postgresql
DB_TYPE=postgresql

# MySQL 설정 (DB_TYPE=mysql일 때)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=milkweb
# DB_USERNAME=root
# DB_PASSWORD=your_password

# PostgreSQL 설정 (DB_TYPE=postgresql일 때)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=milkweb
DB_USERNAME=postgres
DB_PASSWORD=your_password

# 파일 저장 경로
FILE_LOCATION=C:/upload

# 매일 서비스 앱 비밀번호
MAIL_APP_EMAIL=email
MAIL_APP_PWD=app_password

# Oauth2
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
NAVER_CLIENT_ID=naver_client_id
NAVER_CLIENT_SECRET=naver_client_secret