# Database 설정
# DB_TYPE: mysql 또는 postgresql
DB_TYPE=postgresql

# MySQL 설정 (DB_TYPE=mysql일 때)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=milkweb
# DB_USERNAME=root
# DB_PASSWORD=your_password

# PostgreSQL 설정 (DB_TYPE=postgresql일 때)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=milkweb
DB_USERNAME=postgres
DB_PASSWORD=your_password

# 파일 저장 경로
FILE_LOCATION=C:/upload